# ------------------------------------------------------------------------------
# 🔒 LOCAL DEV TOOLS & IDE FILES
# ------------------------------------------------------------------------------
.ddev
!.ddev/.gitkeep
!.ddev/config.example.yaml
.idea
.vscode
*.code-workspace
*.swp
*.swo
*.bak
*.tmp
*.DS_Store
Thumbs.db
/.env
/.env.local
/.env.*.local

# ------------------------------------------------------------------------------
# 📦 COMPOSER & DEPENDENCIES
# ------------------------------------------------------------------------------
/vendor
/web/vendor
/web/core
/web/modules/contrib
/web/themes/contrib
/web/profiles/contrib
/web/recipes
/node_modules

# ------------------------------------------------------------------------------
# 🧠 DRUPAL AUTO-GENERATED FILES
# ------------------------------------------------------------------------------
/files
/web/sites/*/files
/web/sites/*/private
/web/sites/*/public
/web/sites/*/files-public
/web/sites/*/files-private
/web/sites/*/tmp
/web/sites/*/translations
/web/sites/*/cache
/web/sites/*/settings.*.php
/web/sites/*/*settings*.php
/web/sites/*/*services*.yml
/web/sites/development.services.yml
/web/sites/example.settings.local.php
/web/sites/example.sites.php

# ------------------------------------------------------------------------------
# 📄 COMMON WEB ROOT FILES (Rebuildable or Default)
# ------------------------------------------------------------------------------
/web/autoload.php
/web/composer.lock
/web/index.php
/web/update.php
/web/web.config
/web/modules/README.txt
/web/profiles/README.txt
/web/sites/README.txt
/web/themes/README.txt
/web/README.txt
/web/INSTALL.txt
/web/LICENSE.txt
/web/robots.txt
/web/.htaccess
/web/.editorconfig
/web/.csslintrc
/web/.eslintrc.json
/web/.eslintignore
/web/.ht.router.php
/web/.gitattributes
/web/example.gitignore
/web/composer.json

# ------------------------------------------------------------------------------
# 🔧 EXECUTABLES & BINARY TOOLS
# ------------------------------------------------------------------------------
/composer.phar
/robo.phar
/drush.phar
/drupal.phar
/drush
/robo
/drupal

# ------------------------------------------------------------------------------
# 📚 LIBRARIES (Managed by composer or front-end tools)
# ------------------------------------------------------------------------------
/web/libraries/*
!web/libraries/.gitkeep  # allow placeholder if needed
!web/libraries/custom

# ------------------------------------------------------------------------------
# Exclude Logs
# ------------------------------------------------------------------------------
/logs
/web/sites/*/logs

# ------------------------------------------------------------------------------
# Exclude PHP Unit and Test Artifacts
# ------------------------------------------------------------------------------
/.phpunit.result.cache
/phpunit.xml
/web/sites/simpletest
/coverage

# ------------------------------------------------------------------------------
# Exclude Database Dumps
# ------------------------------------------------------------------------------
*.sql
*.sqlite
*.sql.gz
